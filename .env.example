# HyperDX / ClickStack standalone deployment
COMPOSE_PROJECT_NAME=hyperdx
CONTAINER_NAME=hyperdx
CLICKSTACK_IMAGE=clickhouse/clickstack-all-in-one:2.37.0

# URL users open in their browser. No trailing slash.
# Examples:
#   http://server-ip:8080
#   https://hd.example.com   # when TLS/reverse proxy is managed outside this repo
PUBLIC_URL=http://localhost:8080

# Required for a non-development deployment.
# scripts/setup.sh replaces CHANGE_ME with a random value.
EXPRESS_SESSION_SECRET=CHANGE_ME

HYPERDX_LOG_LEVEL=info
USAGE_STATS_ENABLED=true

# HyperDX UI
UI_BIND_ADDRESS=0.0.0.0
UI_PORT=8080

# OpenTelemetry receivers
OTLP_BIND_ADDRESS=0.0.0.0
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Keep ClickHouse HTTP local unless you intentionally need remote access.
CLICKHOUSE_BIND_ADDRESS=127.0.0.1
CLICKHOUSE_HTTP_PORT=8123

# Persistent data
DATA_DIR=./volumes

# Docker log rotation
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5
